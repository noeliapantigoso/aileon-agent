# Copy this file to .env and fill in your own values.
# DO NOT commit .env to git.
#
# Only ONE setting is required: a model. Everything below it is an optional
# integration — leave a block empty and that integration stays off. The agent
# starts either way and tells you at boot what it has.


# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — pick one
# ═══════════════════════════════════════════════════════════════════════════

# Google AI Studio key. Free to create at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ...or leave the key empty and set a GCP project to use Vertex AI instead.
# GCP_PROJECT_ID=your-gcp-project

# With just this, the agent runs, remembers, learns skills and answers on
# POST /api/v1/chat. Add whatever else you want below.


# ═══════════════════════════════════════════════════════════════════════════
# STORAGE
# ═══════════════════════════════════════════════════════════════════════════

# sqlite    — one local file. No account, no project, no network. The default.
# firestore — Google Cloud Firestore. Needs GCP_PROJECT_ID.
# auto      — firestore when a GCP project is set, sqlite otherwise.
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/aileon.db

# Prefixes every collection, so several agents can share one database.
FIRESTORE_COLLECTION_PREFIX=assistant


# ═══════════════════════════════════════════════════════════════════════════
# TELEGRAM (optional) — how you actually talk to it day to day
# ═══════════════════════════════════════════════════════════════════════════

# Leave TELEGRAM_BOT_TOKEN empty to run without a bot.
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_ALLOWED_USER_ID=            # Your user id, from @userinfobot

# Webhook mode. Leave empty when running locally.
TELEGRAM_WEBHOOK_SECRET=             # secrets.token_urlsafe(32)
TELEGRAM_WEBHOOK_URL=                # Public URL of your deployment

# A second bot writing to a separate chat, so the agent's internal activity log
# never mixes with the real conversation.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=


# ═══════════════════════════════════════════════════════════════════════════
# NOTION (optional) — where tasks, goals and key results live
# ═══════════════════════════════════════════════════════════════════════════

# Without these, the agent keeps memory, skills, experiments and the proactive
# cycle; the 14 task and goal tools are simply not offered to the model.
# Database ids come from the URL: notion.so/xxxxxxxx?v=yyy -> xxxxxxxx
NOTION_TOKEN=                        # Internal integration token, ntn_...
NOTION_TASKS_DB=
NOTION_NOTES_DB=
NOTION_GOALS_DB=
NOTION_KEY_RESULTS_DB=


# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE CALENDAR (optional) — needed for the day planner
# ═══════════════════════════════════════════════════════════════════════════

# Run setup_calendar_oauth.py to produce this file. On Google Cloud the token
# is read from Secret Manager instead, and this path is ignored.
CALENDAR_TOKEN_PATH=token.json


# ═══════════════════════════════════════════════════════════════════════════
# MEM0 (optional) — episodic memory across conversations
# ═══════════════════════════════════════════════════════════════════════════

MEM0_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# MODEL
# ═══════════════════════════════════════════════════════════════════════════

# Does the reasoning: chat, planner and the weekly analysis.
GEMINI_MODEL=gemini-2.5-pro

# Classification only, on every message. Cheap on purpose.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite


# ═══════════════════════════════════════════════════════════════════════════
# USER AND SERVER
# ═══════════════════════════════════════════════════════════════════════════

USER_NAME=YourName
USER_TIMEZONE=America/Lima
USER_ID=user

# Protects POST /api/v1/tick and /api/v1/proactive from being triggered by
# anyone. Required once the deployment is reachable from the internet.
PROACTIVE_SECRET=

DEBUG=false
LOG_LEVEL=INFO
